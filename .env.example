# Traffic preset: how hard open tabs poll /api/stats (each poll = 1 Vercel CDN request).
# Auto-refresh only runs for a few minutes after the page opens, then stops until the viewer
# taps the status pill — so forgotten tabs cost nothing.
#   normal — every 60s, for 5 minutes (default)
#   busy   — every 120s, for 3 minutes
#   surge  — no auto-refresh; viewers tap the status pill to update
# Changing it and redeploying also affects tabs that are already open.
TRAFFIC_MODE=normal

# Optional overrides of the preset. POLL_INTERVAL_SEC=0 means manual refresh only.
# POLL_INTERVAL_SEC=60
# AUTO_REFRESH_MIN=5
